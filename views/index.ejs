<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GENCANA - Celebración de Graduados</title>
    <style>
        :root { --primary: #ff7b00; --bg-dark: #0a0a0a; --glass: rgba(30, 30, 30, 0.7); }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Montserrat', 'Segoe UI', sans-serif; }
        body { background: var(--bg-dark); color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; background-image: radial-gradient(circle at top right, #3a1c00, #0a0a0a 60%); }
        
        .main-wrapper { display: flex; width: 90%; max-width: 1200px; margin: 40px auto; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8); }
        
        /* Columna de Información */
        .info-panel { flex: 1; background: url('https://images.unsplash.com/photo-1514525253161-7a46d19cd819?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80') center/cover; position: relative; padding: 40px; display: flex; flex-direction: column; justify-content: center; }
        .info-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(0,0,0,0.9) 0%, rgba(255, 123, 0, 0.4) 100%); z-index: 1; }
        .info-content { position: relative; z-index: 2; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
        
        .title-gencana { font-size: 3em; font-weight: 900; color: var(--primary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 3px; }
        .subtitle { font-size: 1.2em; margin-bottom: 30px; border-bottom: 2px solid var(--primary); padding-bottom: 15px; display: inline-block; }
        
        .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px; font-size: 0.9em; }
        .detail-box { background: rgba(0,0,0,0.6); padding: 15px; border-left: 3px solid var(--primary); border-radius: 4px; }
        .detail-box h4 { color: var(--primary); margin-bottom: 5px; font-size: 1.1em;}
        
        .prices { background: rgba(255, 123, 0, 0.15); padding: 20px; border: 1px solid var(--primary); border-radius: 8px; margin-bottom: 20px; }
        .prices ul { list-style: none; line-height: 1.8; }
        .prices li::before { content: '💲 '; }
        
        /* Columna del Formulario */
        .form-panel { flex: 1; background: var(--glass); backdrop-filter: blur(20px); padding: 50px; border-left: 1px solid rgba(255,255,255,0.1); }
        .form-panel h3 { margin-bottom: 25px; font-size: 1.8em; font-weight: 300; }
        
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; color: #aaa; font-size: 0.9em; text-transform: uppercase; letter-spacing: 1px; }
        input[type="text"], input[type="email"], select, input[type="file"] { width: 100%; padding: 15px; background: rgba(0,0,0,0.5); border: 1px solid #333; color: white; border-radius: 8px; font-size: 1em; transition: all 0.3s; }
        input:focus, select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 15px rgba(255,123,0,0.3); }
        
        select { cursor: pointer; appearance: none; }
        
        button[type="submit"] { width: 100%; padding: 18px; background: var(--primary); color: #000; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; text-transform: uppercase; cursor: pointer; transition: 0.3s; margin-top: 10px; }
        button[type="submit"]:hover { background: #fff; color: var(--primary); box-shadow: 0 0 20px var(--primary); }
        
        /* Reproductor musical flotante */
        #music-control { position: fixed; bottom: 20px; right: 20px; background: var(--primary); color: #000; padding: 15px 25px; border-radius: 50px; cursor: pointer; font-weight: bold; z-index: 100; box-shadow: 0 4px 15px rgba(0,0,0,0.5); border: none;}
        
        @media (max-width: 800px) { .main-wrapper { flex-direction: column; } .details-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    
    <!-- Audio Oculto -->
    <audio id="bg-audio" loop>
    <source src="/public/uploads/cancion.mp3" type="audio/mpeg">
</audio>
    <button id="music-control" onclick="toggleMusic()">🎵 Activar Música</button>

    <div class="main-wrapper">
        
        <!-- Lado Izquierdo: Póster -->
        <div class="info-panel">
            <div class="info-overlay"></div>
            <div class="info-content">
                <h1 class="title-gencana">GENCANA</h1>
                <div class="subtitle">Celebración de Graduados 2026</div>
                
                <div class="details-grid">
                    <div class="detail-box">
                        <h4>📅 Cuándo y Dónde</h4>
                        <p><b>28 de Agosto</b></p>
                        <p>Inicio: 6:30 PM (Eucaristía)</p>
                        <p>Lugar: Parroquia Cristo Resucitado</p>
                        <p>Fin del evento: 12:00 AM</p>
                    </div>
                    <div class="detail-box">
                        <h4>👔 Código de Vestimenta</h4>
                        <p><b>Estrictamente Formal</b></p>
                        <p style="color:#ff4444; font-size:0.85em; margin-top:5px;">⚠️ Multa de $5.00 si no se cumple con la vestimenta adecuada.</p>
                    </div>
                </div>

                <div class="prices">
                    <h4 style="color:var(--primary); margin-bottom:10px;">💳 Tarifas Oficiales:</h4>
                    <ul>
                        <li><b>$3.50</b> - Pre-inscripción (Válido hasta el 20 de Agosto)</li>
                        <li><b>$4.00</b> - Inscripción General</li>
                        <li><b>$5.00</b> - Inscripción sin asistencia a Eucaristía</li>
                    </ul>
                    <p style="margin-top:15px; font-size:0.85em; color:#ddd;">
                        Depositar a: <br><strong style="color:white;"><%= config.cuenta_bancaria %></strong>
                    </p>
                </div>

                <div style="font-size: 0.9em; line-height:1.5;">
                    ✨ <b>Incluye:</b> Servicio de Bar, Votación por el Rey y la Reina, DJ en vivo, Animación, Comida y muchas sorpresas más.
                </div>
            </div>
        </div>

        <!-- Lado Derecho: Formulario -->
        <div class="form-panel">
            <h3>Registro Oficial</h3>
            <form action="/inscribirse" method="POST" enctype="multipart/form-data">
                
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" name="nombre" required autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="email" required autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Teléfono / WhatsApp</label>
                    <input type="text" name="telefono" required autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Sede a la que perteneces</label>
                    <select name="sede" required>
                        <option value="" disabled selected>-- Selecciona tu sede --</option>
                        <option value="Gasca">Gasca</option>
                        <option value="Carcelén">Carcelén</option>
                        <option value="Rumiñahui">Rumiñahui</option>
                        <option value="La dolorosa - IESS fut">La dolorosa - IESS fut</option>
                        <option value="Cristo Resucitado">Cristo Resucitado</option>
                        <option value="Chillogallo">Chillogallo</option>
                        <option value="San Pablo Apóstol - El barco">San Pablo Apóstol - El barco</option>
                        <option value="Cutuglahua">Cutuglahua</option>
                        <option value="San Pedro de Taboada">San Pedro de Taboada</option>
                        <option value="Sangolqui">Sangolqui</option>
                        <option value="Externo">Externo</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Comprobante de Pago</label>
                    <input type="file" name="comprobante" accept="image/*,application/pdf" required>
                </div>

                <button type="submit">Confirmar Asistencia</button>
            </form>
        </div>
    </div>

    <script>
        // Script para controlar el reproductor de música
        function toggleMusic() {
            var audio = document.getElementById("bg-audio");
            var btn = document.getElementById("music-control");
            if (audio.paused) {
                audio.play();
                btn.innerHTML = "⏸️ Pausar Música";
            } else {
                audio.pause();
                btn.innerHTML = "🎵 Activar Música";
            }
        }
    </script>
</body>
</html>